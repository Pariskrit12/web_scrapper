# MongoDB Atlas connection string (mongodb+srv://user:pass@cluster.mongodb.net/)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=kpop_news
MONGO_COLLECTION=articles

# Daily scrape schedule (used by the scheduler service only)
SCRAPE_CRON_HOUR=6
SCRAPE_CRON_MINUTE=0
SCRAPE_TIMEZONE=UTC

EXCEL_EXPORT_PATH=kpop_news.xlsx

API_HOST=0.0.0.0
API_PORT=8000

LOG_LEVEL=INFO
LOG_FILE=logs/app.log

ALLKPOP_CLOUDFLARE_TIMEOUT_MS=45000
